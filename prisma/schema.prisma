// A & I — commerce data model (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  VENDOR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SOLD_OUT
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ShipmentStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RTO
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  REFUNDED
}

enum ReturnReason {
  SIZE_ISSUE
  DAMAGED
  NOT_AS_DESCRIBED
  CHANGED_MIND
  QUALITY_ISSUE
  OTHER
}


// ── Identity / accounts (Memory layer) ─────────────────────────────
// ─────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  passwordHash  String?
  role          Role        @default(CUSTOMER)

  // Nullable unless the user is a vendor
  vendorId      String?     @unique
  vendor        Vendor?     @relation(fields: [vendorId], references: [id])

  savedSize     String?
  stylePrefs    Json?
  referralCode  String?     @unique   // their own shareable "give 10%, get 10%" code

  addresses     Address[]
  orders        Order[]
  wishlist      Wishlist[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Address {
  id            String      @id @default(cuid())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  phone         String

  line1         String
  line2         String?

  city          String
  state         String
  pincode       String
  country       String      @default("IN")

  isDefault     Boolean     @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
}

// ── Vendor management ──────────────────────────────────────────────
model Vendor {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  email      String
  phone      String?
  status     VendorStatus @default(PENDING)
  commission Float        @default(0.15)   // platform cut
  moq        Int          @default(1)      // minimum order qty for production
  users      User[]
  products   Product[]
  payouts    VendorPayment[]
  purchaseOrders PurchaseOrder[]
  materials      Material[]
  materialOrders MaterialOrder[]
  createdAt  DateTime     @default(now())
}

// Every completed Production Order generates a payable amount to its vendor.
// VendorPayment records what's actually been paid against that — either tied
// to one specific Production Order, or as a general/lump-sum payment.
model VendorPayment {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  poId      String?
  po        PurchaseOrder? @relation(fields: [poId], references: [id])
  amount    Int                                    // in paise
  method    String?                                // bank transfer | UPI | cash, etc.
  reference String?                                // transaction ID / cheque number
  notes     String?
  status    String        @default("PAID")         // PAID (payments are logged after the fact) | PENDING (scheduled but not sent)
  createdAt DateTime      @default(now())
}

// ── Catalogue / CMS ────────────────────────────────────────────────
model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  story       String?                                  // narrative, not description
  status      ProductStatus  @default(ACTIVE)
  category    String                                   // ready | craft | linen
  occasion    String[]                                 // for multi-filter / SEO
  colorHex    String
  colorName   String?
  fabric      String?
  basePrice   Int                                      // paise — the selling price
  discountPercent Int?                                  // 0-99 — when set, a derived "was" price + %-off badge shows on the storefront
  costPrice   Int?                                     // paise — landed cost per unit, drives margin/profit reporting
  vendorCost  Int?                                      // paise — what's paid to the vendor specifically, if different from costPrice
  featured      Boolean      @default(false)   // shows in Home's "Hand-picked" section
  featuredOrder Int          @default(0)       // lower = earlier, when featured is true
  lookbookOrder Int?                           // null = not in Lookbook; set = position (ascending)
  preOrder      Boolean      @default(false)   // production hasn't started — PDP shows "Reserve" instead of "Add to bag"
  preOrders     PreOrder[]
  vendorId    String
  vendor      Vendor         @relation(fields: [vendorId], references: [id])
  images      ProductImage[]
  variants    Variant[]
  tiers       FabricTier[]
  reviews     Review[]
  orderItems  OrderItem[]
  wishlist    Wishlist[]
  notify      NotifyRequest[]
  blogTags    BlogPostProduct[]
  poItems     PurchaseOrderItem[]
  bom         ProductMaterial[]
  dropId      String?
  drop        Drop?          @relation(fields: [dropId], references: [id])
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([category])
  @@index([status])
  @@index([vendorId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
}

model Variant {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String                                 // XS..XL / One Size
  sku       String  @unique
  stock     Int     @default(0)
  @@unique([productId, size])
}

model FabricTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String                                 // Signature / Premium / Couture
  priceAdd  Int     @default(0)                    // paise added to basePrice
  position  Int     @default(0)
}

// ── Drops / scarcity ───────────────────────────────────────────────
model Drop {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  liveAt    DateTime
  products  Product[]
  createdAt DateTime  @default(now())
}

model NotifyRequest {                                // back-in-stock waitlist
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email     String
  size      String?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([productId, email, size])
}

model ContactMessage {                               // "Contact us" form submissions
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String   @default("general")             // general | wholesale | press | vendor
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Pre-order / waitlist-to-production — validates real demand for a piece
// before a single unit is cut, per the "inventory is risk, data reduces
// risk" principle in the business plan's drop system.
model PreOrder {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size         String
  name         String?
  email        String
  phone        String?
  location     String?
  qty          Int      @default(1)
  status       String   @default("PENDING")          // PENDING | CONTACTED | CONFIRMED | FULFILLED | CANCELLED
  discountCode String?                                // small incentive for committing early
  createdAt    DateTime @default(now())
  @@index([productId])
  @@index([status])
}

// ── Orders (OMS) ───────────────────────────────────────────────────
// Referral codes ("give 10%, get 10%") and general discount codes. A
// referral code is a permanent, multi-use PromoCode owned by one customer;
// redeeming it (at checkout) creates a fresh single-use reward PromoCode for
// the referrer as their "get 10%" side of the deal.
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  percentOff      Int      @default(10)
  source          String   @default("REFERRAL")   // REFERRAL | REWARD | MANUAL
  referrerUserId  String?                          // whose referral this is (for REFERRAL codes)
  rewardForUserId String?                          // who this reward belongs to (for REWARD codes)
  maxRedemptions  Int      @default(1)
  redemptions     Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  @@index([referrerUserId])
  @@index([rewardForUserId])
}

// ── Journal / editorial blog — admin-authored, shoppable ───────────
model BlogPost {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  subtitle    String?
  coverImage  String?
  body        String                                     // paragraphs, plain text (double newline = new paragraph)
  status      String            @default("DRAFT")        // DRAFT | PUBLISHED
  authorName  String            @default("A & I Editorial")
  publishedAt DateTime?
  products    BlogPostProduct[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([status])
  @@index([publishedAt])
}

model BlogPostProduct {                                   // "Shop this post" tagging
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  @@unique([postId, productId])
}

// ── Raw materials & Bill of Materials (Phase 1 of the Admin OS roadmap) ──
// Materials are tracked separately from finished-goods Products. A product's
// "recipe" (ProductMaterial / BOM) says how much of each material one unit
// needs — this is what Production Planning will check against available
// stock before recommending a Purchase Order or greenlighting production.
model Material {
  id           String              @id @default(cuid())
  name         String
  sku          String              @unique
  unit         String              @default("meters")  // meters | pieces | kg | rolls, etc.
  costPerUnit  Int                                       // paise
  stockQty     Float               @default(0)
  reorderLevel Float               @default(0)           // below this, Dashboard's "Low Materials" flags it
  vendorId     String?                                    // preferred supplier, if any
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  bom          ProductMaterial[]
  orderItems   MaterialOrderItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProductMaterial {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  qtyPerUnit Float                                        // how much this material is needed per single garment
  @@unique([productId, materialId])
}

// Raw-material procurement from a supplier — distinct from PurchaseOrder
// (which orders *finished goods* from a vendor/atelier). Receiving a
// MaterialOrder automatically increments the linked Material's stockQty.
model MaterialOrder {
  id           String              @id @default(cuid())
  orderNumber  String              @unique
  vendorId     String?
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  supplierName String?                                    // for raw-material suppliers who aren't a garment Vendor
  expectedDate DateTime?
  status       String              @default("DRAFT")      // DRAFT | SENT | ACCEPTED | IN_TRANSIT | RECEIVED
  notes        String?
  items        MaterialOrderItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model MaterialOrderItem {
  id         String        @id @default(cuid())
  orderId    String
  order      MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId String
  material   Material      @relation(fields: [materialId], references: [id])
  qty        Float
  rate       Int                                           // paise per unit
  position   Int           @default(0)
}

model Order {
  id          String        @id @default(cuid())
  number      String        @unique                 // human-friendly e.g. AI-10231
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  email       String
  status      OrderStatus   @default(PENDING)
  items       OrderItem[]
  subtotal    Int
  shipping    Int           @default(0)
  discount    Int           @default(0)                // paise, from an applied promo code
  discountCode String?
  total       Int
  currency    String        @default("INR")
  note        String?
  shipName    String?
  shipPhone   String?
  shipLine1   String?
  shipCity    String?
  shipState   String?
  shipPincode String?
  payment     Payment?
  shipment    Shipment?
  returns     Return[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  vendorId    String                                   // denormalised for vendor scoping
  name        String
  size        String
  tier        String?
  unitPrice   Int
  qty         Int      @default(1)
  passport    Passport?
  returns     Return[]
  @@index([vendorId])
  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String        @default("razorpay")
  rzpOrderId    String?
  rzpPaymentId  String?
  rzpSignature  String?
  status        PaymentStatus @default(CREATED)
  amount        Int
  method        String?                                // upi / card / netbanking
  createdAt     DateTime      @default(now())
}

// ── Delivery / logistics ────────────────────────────────────────────
model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String?                                  // Delhivery / Shiprocket / Bluedart / DTDC / self
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(LABEL_CREATED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  estDelivery    DateTime?
  events         ShipmentEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ShipmentEvent {                                     // carrier tracking timeline
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  at         DateTime @default(now())
}

// ── Returns / refunds ────────────────────────────────────────────────
model Return {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  reason        ReturnReason
  note          String?
  status        ReturnStatus @default(REQUESTED)
  refundAmount  Int?                                       // paise; set on approval
  refundedAt    DateTime?
  rzpRefundId   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@index([orderId])
  @@index([status])
}

// ── Trust layer: garment passport (QR/NFC) ─────────────────────────
model Passport {
  id           String   @id @default(cuid())
  serial       String   @unique                        // encoded in QR / NFC
  orderItemId  String   @unique
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  designer     String?
  materialOrigin String?
  madeAt       String?
  sustainability Json?
  createdAt    DateTime @default(now())
}

// ── Misc ───────────────────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model InventoryLedger {                                // audit trail
  id        String   @id @default(cuid())
  variantId String
  delta     Int
  reason    String                                     // ORDER / RESTOCK / ADJUST
  refId     String?
  createdAt DateTime @default(now())
}

model WebhookEvent {                                   // idempotency for payments
  id        String   @id @default(cuid())
  provider  String
  eventId   String   @unique
  payload   Json
  createdAt DateTime @default(now())
}

// Site-wide, admin-configurable settings — the "control panel" for
// everything that shouldn't require a code change: favicon, social links,
// SEO defaults, analytics IDs, announcement bar copy. Always exactly one row.
// Product categories — fully backend-configurable (Admin → Categories).
// Product.category stays a plain string (matching a Category.slug) rather
// than a hard foreign key, so existing product rows never need a migration
// when categories are renamed or reorganized.
model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  position Int     @default(0)
  active   Boolean @default(true)
}

// Purchase orders — admin generates an editable, printable PO per vendor to
// request production of specific pieces/quantities. No payment flows through
// this; it's a paper trail between A&I and the atelier.
model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  vendorId         String
  payments         VendorPayment[]
  vendor           Vendor              @relation(fields: [vendorId], references: [id])
  notes            String?
  terms            String?
  status           String              @default("DRAFT")   // DRAFT | SENT | ACCEPTED | IN_PROGRESS | READY_FOR_PICKUP | COMPLETED
  priority         String              @default("NORMAL")  // LOW | NORMAL | HIGH | URGENT
  expectedDelivery DateTime?
  measurementNotes String?                                 // custom measurements / fit notes for this production run
  referenceImages  String[]                                 // blueprint / reference photo URLs
  items            PurchaseOrderItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model PurchaseOrderItem {
  id            String        @id @default(cuid())
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String
  size          String?                                      // which size this line is producing, if applicable
  qty           Int
  unitCost      Int                                           // paise
  position      Int           @default(0)
  qualityChecks QualityCheck[]
}

// Quality control on finished goods arriving from a Production Order.
// Passing a check auto-increments the matching Product/size's stock —
// nothing should require a manual stock adjustment unless explicitly done.
model QualityCheck {
  id          String            @id @default(cuid())
  poItemId    String
  poItem      PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  checklist   Json                                            // { stitching: true, measurements: true, colorMatch: true, embroidery: true, packaging: true }
  qtyChecked  Int
  qtyPassed   Int
  qtyFailed   Int
  result      String            @default("PENDING")           // PASSED | FAILED | PARTIAL
  notes       String?
  photos      String[]
  inspectedBy String?
  createdAt   DateTime          @default(now())
}

model SiteSettings {
  id                     String   @id @default("singleton")
  siteName               String   @default("A&I")
  tagline                String?  @default("Style With Us")
  description            String?  @default("Indian craft, global silhouette. Womenswear handmade in small runs across India.")
  faviconUrl             String?
  logoUrl                String?
  ogImageUrl             String?
  announcementText       String?  @default("Made in India, in small runs")
  socialInstagram        String?
  socialWhatsapp         String?
  socialPinterest        String?
  socialFacebook         String?
  socialTwitter          String?
  contactEmail           String?
  contactPhone           String?
  gaMeasurementId        String?                                  // GA4 "G-XXXXXXX"
  googleSiteVerification String?                                  // Search Console meta tag content
  bingSiteVerification   String?                                  // Bing Webmaster meta tag content
  updatedAt              DateTime @updatedAt
}
